# Copy to .env (gitignored). Only needed for HTTPS on the Tailscale domain:
# a Cloudflare API token scoped to the one zone, permission DNS:Edit.
CLOUDFLARE_API_TOKEN=

# Login (optional). Generate with scripts/set-password.sh, which writes these.
# Leave GANTRY_PASSWORD_HASH empty to run without a login, as before.
GANTRY_USERNAME=admin
GANTRY_PASSWORD_HASH=
# Bearer token for the MCP server once login is on: openssl rand -hex 32
GANTRY_API_TOKEN=
# Extra names Gantry may be opened on (comma list, *.suffix ok), e.g. myhost.lan
GANTRY_ALLOWED_HOSTS=

# Host terminal (optional; requires the login above). Set up with
# scripts/enable-host-shell.sh, which fills these in.
GANTRY_HOST_SHELL=0
GANTRY_HOST_SHELL_USER=
